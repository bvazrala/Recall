# Port for the Mastra server. The web app's NEXT_PUBLIC_API_URL should point here.
PORT=4111
# Origin of the Next.js dashboard, allowed through CORS.
WEB_ORIGIN=http://localhost:3000

# Neon Postgres connection string (same database as packages/db).
DATABASE_URL=

# Claude API key from the Claude Console (platform.claude.com). Needed to write quizzes.
ANTHROPIC_API_KEY=

