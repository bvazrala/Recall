# Where the browser sends API calls. "/backend" goes through the Next.js proxy (see next.config.ts),
# which works on a phone through a tunnel. Use http://localhost:4111 to call the Mastra server directly.
NEXT_PUBLIC_API_URL=/backend

# Where the proxy forwards /backend/* to (server-side only). Defaults to the local Mastra server.
API_ORIGIN=http://localhost:4111

# The student the dashboard acts as until sign-in is wired (students.id from the database).
NEXT_PUBLIC_STUDENT_ID=
