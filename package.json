{
  "name": "recall",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc -p .",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @recall/db generate",
    "db:migrate": "pnpm --filter @recall/db migrate",
    "db:check": "pnpm --filter @recall/db check"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
