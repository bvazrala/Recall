{
  "name": "recall",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r exec tsc -p .",
    "test": "pnpm -r --if-present run test",
    "db:generate": "pnpm --filter @recall/db generate",
    "db:migrate": "pnpm --filter @recall/db migrate",
    "db:check": "pnpm --filter @recall/db check",
    "claude:check": "pnpm --filter @recall/server claude:check",
    "seed:fresh": "pnpm --filter @recall/db seed:fresh",
    "seed:mid": "pnpm --filter @recall/db seed:mid"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0"
  }
}
